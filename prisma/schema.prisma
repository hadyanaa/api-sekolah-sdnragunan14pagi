datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// -------------------------------------------------------------
// ENUM PILIHAN STATUS SISWA (Fitur Native PostgreSQL)
// -------------------------------------------------------------
enum StatusSiswa {
  AKTIF   // Masih bersekolah
  ALUMNI  // Sudah lulus / alumni
}

// -------------------------------------------------------------
// 1. TABEL SISWA (Tabel lama tetap ada + kolom status)
// -------------------------------------------------------------
model Siswa {
  id          Int         @id @default(autoincrement())
  nisn        String?     @unique
  nis         String?
  nama        String
  gender      String?     // "L" / "P" atau "Laki-laki" / "Perempuan"
  kelas       String?     // contoh: "1A", "6B"
  tglLahir    DateTime?   @map("tgl_lahir")
  tempatLahir String?     @map("tempat_lahir")
  alamat      String?     @db.Text
  namaOrtu    String?     @map("nama_ortu")
  noTelpOrtu  String?     @map("no_telp_ortu")

  // Kolom status sesuai permintaan (Pilihan: AKTIF atau ALUMNI)
  status      StatusSiswa @default(AKTIF)
  tahunLulus  String?     @map("tahun_lulus") // Opsional: tahun kelulusan untuk arsip alumni

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("siswa")
}

// -------------------------------------------------------------
// 2. TABEL VISI & MISI
// -------------------------------------------------------------
model VisiMisi {
  id           Int      @id @default(autoincrement())
  visi         String   @db.Text
  misi         String   @db.Text
  tujuan       String?  @db.Text
  visiEkskul   String?  @map("visi_ekskul") @db.Text
  misiEkskul   String?  @map("misi_ekskul") @db.Text
  tujuanEkskul String?  @map("tujuan_ekskul") @db.Text
  fungsiEkskul String?  @map("fungsi_ekskul") @db.Text

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("visi_misi")
}

// -------------------------------------------------------------
// 3. TABEL SDM (Pendidik & Tenaga Kependidikan)
// -------------------------------------------------------------
model Sdm {
  id               Int       @id @default(autoincrement())
  nama             String
  nipNikki         String?   @map("nip_nikki") // NIP (PNS) atau NIKKI (Non-PNS / Kontrak DKI)
  gender           String?   // "L" / "P"
  tglLahir         DateTime? @map("tgl_lahir")
  tmt              DateTime? // Terhitung Mulai Tanggal
  status           String?   // PNS, PPPK, Honorer, KKI, Tenaga Kontrak, dsb.
  jabatan          String    // Kepala Sekolah, Guru Kelas, Guru PJOK, Tata Usaha, dsb.
  deskripsiJabatan String?   @map("deskripsi_jabatan") @db.Text
  pendidikan       String?   // S1, S2, D3, SMA
  jurusan          String?   // PGSD, Penjas, Pendidikan Bahasa, dsb.
  
  // Tambahan analisis untuk profil website:
  fotoUrl          String?   @map("foto_url")
  noTelp           String?   @map("no_telp")
  email            String?

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("sdm")
}

// -------------------------------------------------------------
// 4. TABEL PRESTASI
// -------------------------------------------------------------
model Prestasi {
  id            Int       @id @default(autoincrement())
  nama          String    // Nama kejuaraan / lomba
  namaPeserta   String?   @map("nama_peserta") // Tambahan analisis: nama siswa atau regu pemenang
  peraih        String?   // Alias peraih untuk admin & dashboard
  tanggal       DateTime?
  kategori      String?   // Akademik, Olahraga, Seni & Budaya, dll.
  deskripsi     String?   @db.Text
  peringkat     String?   // Juara 1, Juara 2, Medali Emas, dll.
  tingkat       String?   // Sekolah, Kecamatan, Kota/Kabupaten, Provinsi, Nasional, Internasional
  penyelenggara String?   // Dinas Pendidikan, Kemenpora, dll.
  tempat        String?   // Lokasi penyelenggaraan lomba
  linkFoto      String?   @map("link_foto")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("prestasi")
}

// -------------------------------------------------------------
// 5. TABEL EKSKUL (Ekstrakurikuler)
// -------------------------------------------------------------
model Ekskul {
  id        Int      @id @default(autoincrement())
  nama      String   // Pramuka, Futsal, Tari, Dokter Kecil, dsb.
  pembina   String?  // Nama guru pembina / pelatih
  pj        String?  // Penanggung Jawab
  hari      String?  // Hari pelaksanaan (misal: "Kamis")
  jam       String?  // Jam pelaksanaan (misal: "14:00 - 16:00 WIB")
  waktu     String?  // Jadwal kegiatan (misal: "Jumat, 14.00 - 16.00 WIB")
  deskripsi String?  @db.Text
  tujuan    String?  @db.Text
  materi    String?  @db.Text
  sifat     String?  // "Wajib" atau "Pilihan"
  peserta   String?  // Sasaran peserta (misal: "Kelas 3 - 6")
  linkFoto  String?  @map("link_foto") // Tambahan analisis: foto kegiatan/logo ekskul

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ekskul")
}

// -------------------------------------------------------------
// 6. TABEL AGENDA
// -------------------------------------------------------------
model Agenda {
  id        Int      @id @default(autoincrement())
  judul     String
  deskripsi String?  @db.Text
  kategori  String?  // Rapat, Ujian, Upacara, Kegiatan Sekolah, dsb.
  tanggal   DateTime
  waktu     String?  // Tambahan analisis: jam acara (misal: "08:00 - 12:00 WIB")
  tempat    String?  // Tambahan analisis: lokasi (misal: "Aula SDN 14 Ragunan")
  lokasi    String?  // Alias lokasi untuk admin & dashboard
  linkFoto  String?  @map("link_foto")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("agenda")
}

// -------------------------------------------------------------
// 7. TABEL KALENDER AKADEMIK
// -------------------------------------------------------------
model KalenderAkademik {
  id          Int       @id @default(autoincrement())
  title       String    // Judul kegiatan (kompatibel dengan format FullCalendar / Event calendar)
  start       DateTime  // Tanggal / waktu mulai
  end         DateTime? // Tanggal / waktu selesai
  kategori    String?   // Libur, Ujian, KBM, Hari Besar, dsb.
  deskripsi   String?   @db.Text
  tahunAjaran String?   @map("tahun_ajaran") // Misal: "2024/2025"
  semester    String?   // "Ganjil" atau "Genap"

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("kalender_akademik")
}

// -------------------------------------------------------------
// 8. TABEL PENGUMUMAN
// -------------------------------------------------------------
model Pengumuman {
  id        Int      @id @default(autoincrement())
  judul     String
  isi       String?  @db.Text // Teks detail isi pengumuman
  deskripsi String?  @db.Text // Alias deskripsi untuk dashboard & admin
  tanggal   DateTime @default(now())
  urlFile   String?  @map("url_file") // Link PDF atau berkas lampiran
  kategori  String?  // Pengumuman Umum, PPDB, Akademik, Libur, dsb.
  penulis   String?  // Tambahan analisis: penerbit (misal: "Kepala Sekolah")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pengumuman")
}

// -------------------------------------------------------------
// 9. TABEL FASILITAS
// -------------------------------------------------------------
model Fasilitas {
  id        Int      @id @default(autoincrement())
  nama      String   // Misal: "Laboratorium Komputer", "Perpustakaan", "Ruang UKS"
  deskripsi String?  @db.Text // Penjelasan fasilitas sekolah
  kondisi   String?  // Misal: "Baik", "Sangat Baik"
  linkFoto  String?  @map("link_foto")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("fasilitas")
}

// -------------------------------------------------------------
// 10. TABEL SCHEDULES (Bel Sekolah Otomatis)
// -------------------------------------------------------------
model Schedule {
  id        Int      @id @default(autoincrement())
  name      String   // Misal: "Bel Masuk Murid", "Bel Istirahat", "Bel Pulang"
  days      String   // Contoh: "1,2,3,4,5" (1=Senin s.d. 5=Jumat)
  time      String   // Format "HH:MM", misal "07:00"
  audioFile String   @map("audio_file") // Nama file MP3 di folder /public/audio
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("schedules")
}

// -------------------------------------------------------------
// 11. SISTEM ABSENSI SISWA SEKOLAH
// -------------------------------------------------------------

enum RoleGuru {
  WALI_KELAS
  GURU_MAPEL
  PIKET
}

enum StatusGuru {
  AKTIF         // Masih aktif bertugas di sekolah
  MUTASI_KELUAR // Pindah tugas ke sekolah / instansi lain
  PENSIUN       // Purna tugas / pensiun
}

enum StatusAbsensi {
  H // Hadir
  S // Sakit
  I // Izin
  A // Alpa
  L // Libur
}

enum StatusMurid {
  AKTIF         // Masih aktif belajar di sekolah
  LULUS         // Sudah lulus / alumni
  MUTASI_KELUAR // Pindah / mutasi keluar sekolah
}

// Tabel 1: Kelas (1A sampai 6B)
model Kelas {
  id           Int                 @id @default(autoincrement())
  namaKelas    String              @unique @map("nama_kelas")

  guru         Guru[]              @relation("WaliKelas")
  guruMapel    GuruKelas[]
  murid        Murid[]
  riwayatMurid RiwayatKelasMurid[]

  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@map("kelas")
}

// Tabel 2: Guru
model Guru {
  id                Int                   @id @default(autoincrement())
  username          String                @unique
  nipNikki          String?               @map("nip_nikki")
  nuptk             String?
  nrg               String?
  golonganRuang     String?               @map("golongan_ruang")
  jabatan           String?               // Mapel / bidang tugas (misal: Guru Kelas, Guru PJOK, PAI)
  tmtKerja          DateTime?             @map("tmt_kerja") @db.Date
  tmtSekolah        DateTime?             @map("tmt_sekolah") @db.Date
  tingkatPendidikan String?               @map("tingkat_pendidikan")
  jurusan           String?
  jenisKelamin      String?               @map("jenis_kelamin")
  tempatLahir       String?               @map("tempat_lahir")
  tanggalLahir      DateTime?             @map("tanggal_lahir") @db.Date
  alamat            String?               @db.Text
  status            StatusGuru            @default(AKTIF)
  tahunKeluar       String?               @map("tahun_keluar")
  namaGuru          String                @map("nama_guru")
  password          String
  role              RoleGuru              @default(WALI_KELAS)
  kelasId           Int?                  @map("kelas_id")
  kelas             Kelas?                @relation("WaliKelas", fields: [kelasId], references: [id], onDelete: SetNull)
  kelasMapel        GuruKelas[]
  riwayatMengajar   RiwayatMengajarGuru[]

  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@index([status])
  @@map("guru")
}

// Relasi Many-to-Many: 1 Guru Mapel dapat mengajar banyak kelas, 1 Kelas dapat diisi banyak Guru Mapel
model GuruKelas {
  guruId    Int      @map("guru_id")
  kelasId   Int      @map("kelas_id")
  guru      Guru     @relation(fields: [guruId], references: [id], onDelete: Cascade)
  kelas     Kelas    @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([guruId, kelasId])
  @@map("guru_kelas")
}

// Tabel 2B: Riwayat Mengajar Guru per Tahun Ajaran
model RiwayatMengajarGuru {
  id              Int      @id @default(autoincrement())
  guruId          Int      @map("guru_id")
  guru            Guru     @relation(fields: [guruId], references: [id], onDelete: Cascade)
  tahunAjaran     String   @map("tahun_ajaran")
  role            RoleGuru
  jabatan         String?
  keteranganKelas String   @map("keterangan_kelas")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([guruId, tahunAjaran])
  @@index([tahunAjaran])
  @@map("riwayat_mengajar_guru")
}

// Tabel 3: Murid
model Murid {
  id               Int                 @id @default(autoincrement())
  namaMurid        String              @map("nama_murid")
  noUrut           Int                 @map("no_urut")
  jenisKelamin     String?             @map("jenis_kelamin") // "Laki-laki" / "Perempuan"
  agama            String?
  noKk             String?             @map("no_kk")
  nipd             String?
  nisn             String?
  nik              String?
  tempatLahir      String?             @map("tempat_lahir")
  tanggalLahir     DateTime?           @map("tanggal_lahir") @db.Date
  alamat           String?             @db.Text
  noHp             String?             @map("no_hp")
  status           StatusMurid         @default(AKTIF)
  tahunKeluar      String?             @map("tahun_keluar") // Opsional: tahun lulus atau tahun mutasi
  tahunAjaranAktif String?             @map("tahun_ajaran_aktif") // Penanda tahun ajaran kelas saat ini
  kelasId          Int                 @map("kelas_id")
  kelas            Kelas               @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  absensi          Absensi[]
  riwayatKelas     RiwayatKelasMurid[]

  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([status])
  @@map("murid")
}

// Tabel 3B: Riwayat Kelas & Wali Kelas Murid per Tahun Ajaran
model RiwayatKelasMurid {
  id            Int      @id @default(autoincrement())
  muridId       Int      @map("murid_id")
  murid         Murid    @relation(fields: [muridId], references: [id], onDelete: Cascade)
  tahunAjaran   String   @map("tahun_ajaran")
  kelasId       Int?     @map("kelas_id")
  kelas         Kelas?   @relation(fields: [kelasId], references: [id], onDelete: SetNull)
  namaKelas     String   @map("nama_kelas")
  waliKelasId   Int?     @map("wali_kelas_id")
  namaWaliKelas String?  @map("nama_wali_kelas")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([muridId, tahunAjaran])
  @@index([tahunAjaran])
  @@map("riwayat_kelas_murid")
}

// Tabel 4: Absensi (Upsert harian)
model Absensi {
  id        Int           @id @default(autoincrement())
  muridId   Int           @map("murid_id")
  murid     Murid         @relation(fields: [muridId], references: [id], onDelete: Cascade)
  tanggal   DateTime      @db.Date
  status    StatusAbsensi

  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([muridId, tanggal])
  @@index([tanggal])
  @@map("absensi")
}

